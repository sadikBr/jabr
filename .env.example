# Copy to .env for local development. Never commit .env.

# PostgreSQL. This default matches docker-compose.yml (`bun run db:up`).
# In production use the managed database's connection string (Neon/Supabase).
DATABASE_URL="postgresql://jabr:jabr@localhost:5432/jabr"

# --- Not used yet: arrive with accounts (Phase 3) ---
# AUTH_SECRET=""            # generate with: openssl rand -base64 32
# Each sign-in provider turns on only when both of its values are set.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# One-click demo sign-in for local testing and previews. Never enable in production.
# AUTH_DEMO_LOGIN="false"
